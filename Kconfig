config ZMK_BEHAVIOR_PIR_SWITCH
    bool
    default y
    depends on DT_HAS_ZMK_BEHAVIOR_PIR_SWITCH_ENABLED
    select FLASH
    select FLASH_MAP
    select CRC
    select LED_STRIP

config ZMK_BATTERY_NIMH_VOLTAGE_DIVIDER
    bool
    default y
    depends on DT_HAS_ZMK_BATTERY_NIMH_VOLTAGE_DIVIDER_ENABLED
    select ADC
